        } else {
            isSolidLightLocked = false;
        }
    }

    // Phase-02 & Phase-03: Geometric Crystalline Lock & Kinetic Impact Vectoring
    bool engageSolidLightBarrier(double incomingImpactGj) {
        if (fieldMetrics.localizedPlasmaDensity > 1000.0) {
            std::cout << "🧱 [EMITTER-LOCK]: Freezing ionized plasma fields into rigid, solid-light crystalline planes..." << std::endl;
            isSolidLightLocked = true;

            fieldMetrics.kineticDeflectionLoad = incomingImpactGj;
            std::cout << "🛡️ [EMITTER-LOCK]: Hard-light shield locked! Absorbing " << fieldMetrics.kineticDeflectionLoad << " GJ of incoming force." << std::endl;
            std::cout << "🔄 [EMITTER-LOCK]: Kinetic impact vectoring active. Energy channeled down to ground frames." << std::endl;
            return true;
        }
        return false;
    }

    // Phase-04: Peridot Bio-Electric HUD Feedback Output
    void pushEmitterStatusOverlay() {
        std::cout << "\n================= [ SYSTEM UPDATE: PROJECT EMITTER-LOCK ] =================" << std::endl;
        std::cout << " BARRIER MATRIX  : " << barrierClassification << std::endl;
        std::cout << " EMITTER RECEPTOR: " << hardwareEmitterCount << " ACTIVE SOLID-LIGHT INJECTOR PORTS" << std::endl;

        if (isSolidLightLocked) {
            std::cout << " SHIELD STATUS   : [CRISP PERIDOT-GREEN DEFENSIVE DOME FULLY ENERGIZED]" << std::endl;
            std::cout << " ANOMALY BLOCK   : 100% BALANCED HARD-LIGHT WALL // ZERO KNOCKBACK RETENTION" << std::endl;
